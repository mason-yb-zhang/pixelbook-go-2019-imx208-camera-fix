From: mason <mason@example.com>
Date: Fri, 14 Nov 2026 01:30:00 +0800
Subject: [PATCH] media: i2c: imx208: Add get_selection pad operation (kernel 7.3.x)

libcamera requires the sensor driver to implement the V4L2 subdev
get_selection pad op to query the crop rectangle, crop bounds and native
sensor size. Without it, libcamera prints warnings such as "Unable to get
rectangle 0 on pad 0/0" and the IPU3 pipeline cannot obtain the sensor
crop information.

This is the kernel 7.3.x version of the patch. The driver was refactored
between 7.0 and 7.3:

  - imx208_get_fmt  -> imx208_get_pad_format
  - imx208->mode->format  ->  imx208->cur_mode (width/height directly)

Signed-off-by: mason <mason@example.com>
---
 drivers/media/i2c/imx208.c | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/drivers/media/i2c/imx208.c b/drivers/media/i2c/imx208.c
index d5350bb..67c3756 100644
--- a/drivers/media/i2c/imx208.c
+++ b/drivers/media/i2c/imx208.c
@@ -536,6 +536,33 @@ static int imx208_enum_frame_size(struct v4l2_subdev *sd,
 	return 0;
 }
 
+static int imx208_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx208 *imx208 = to_imx208(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = imx208->cur_mode->width;
+		sel->r.height = imx208->cur_mode->height;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		/* Native pixel array size: 1936 x 1096 */
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = 1936;
+		sel->r.height = 1096;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
 static void imx208_mode_to_pad_format(struct imx208 *imx208,
 				      const struct imx208_mode *mode,
 				      struct v4l2_subdev_format *fmt)
@@ -754,6 +781,7 @@ static const struct v4l2_subdev_pad_ops imx208_pad_ops = {
 	.get_fmt = imx208_get_pad_format,
 	.set_fmt = imx208_set_pad_format,
 	.enum_frame_size = imx208_enum_frame_size,
+	.get_selection = imx208_get_selection,
 };
 
 static const struct v4l2_subdev_ops imx208_subdev_ops = {
